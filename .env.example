# ReportLift Environment Configuration
# Copy this file to .env and update values

# =============================================================================
# Backend Configuration
# =============================================================================

# Database connection (SQL Server)
DATABASE_URL=mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+18+for+SQL+Server

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_EXPIRATION_HOURS=8

# Credential Encryption (REQUIRED in production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Frontend Configuration (build-time)
# =============================================================================

VITE_API_URL=http://localhost:8000

# =============================================================================
# Docker Configuration
# =============================================================================

BACKEND_PORT=8000
FRONTEND_PORT=3000

# =============================================================================
# SSRS Configuration
# =============================================================================

# SSRS_SERVER_URL=http://ssrs-server/ReportServer
# SSRS_USERNAME=
# SSRS_PASSWORD=

# =============================================================================
# Snowflake Configuration
# =============================================================================

# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# =============================================================================
# Snowflake OAuth/SSO Configuration
# =============================================================================
# Configure these settings to enable Snowflake OAuth SSO authentication
# Uses OAuth2 + PKCE flow for secure authentication without storing passwords

# SNOWFLAKE_OAUTH_CLIENT_ID=your-oauth-client-id
# SNOWFLAKE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# SNOWFLAKE_OAUTH_AUTH_URL=https://your-idp.com/oauth/authorize
# SNOWFLAKE_OAUTH_TOKEN_URL=https://your-idp.com/oauth/token
# SNOWFLAKE_OAUTH_REDIRECT_URI=https://reportlift.local/api/v1/auth/snowflake/callback
# SNOWFLAKE_OAUTH_SCOPE=openid profile

# =============================================================================
# Ollama Configuration (AI-Assisted Conversion)
# =============================================================================

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=codellama:13b

# =============================================================================
# TLS/HTTPS Configuration (Production)
# =============================================================================

# TLS_CERT_PATH=/etc/nginx/certs/cert.pem
# TLS_KEY_PATH=/etc/nginx/certs/key.pem
